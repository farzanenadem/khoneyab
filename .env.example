# Copy to .env and fill in. Used by the optional home-buying assistant.
LLM_PROVIDER=openai
LLM_BASE_URL=https://api.metisai.ir/deepseek/v1
LLM_API_KEY=tpsg-your-metis-key
LLM_MODEL=deepseek-v4-pro
LLM_FAST_MODEL=deepseek-v4-flash

# Optional: USD per 1M tokens, enables the cost estimate on the token-usage tab
# LLM_PRICE_IN_PER_M=0.30
# LLM_PRICE_OUT_PER_M=1.20

# Comma-separated browser origins allowed by the API.
# CORS_ORIGINS=http://localhost:3000
# Maximum chat requests per client IP per minute (0 disables the in-process guard).
# LLM_REQUESTS_PER_MINUTE=60

# Local Docker persistence defaults. Use strong values outside development.
POSTGRES_DB=khoneyab
POSTGRES_USER=khoneyab
POSTGRES_PASSWORD=change-me-local

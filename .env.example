# Copy to .env and fill in. Used by the agent (/chat); the job search itself needs no LLM.
LLM_PROVIDER=openai
LLM_BASE_URL=https://api.metisai.ir/deepseek/v1
LLM_API_KEY=tpsg-your-metis-key
LLM_MODEL=deepseek-v4-pro
LLM_FAST_MODEL=deepseek-v4-flash

# Optional: USD per 1M tokens, enables the cost estimate on the token-usage tab
# LLM_PRICE_IN_PER_M=0.30
# LLM_PRICE_OUT_PER_M=1.20
